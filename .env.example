# ---------------------------------------------------------------------------
# MarketShark Trader — environment
#
# Everything below is optional for local development. Production should run in
# live mode, which refuses generated fallback data and shows setup errors until
# a licensed provider is connected.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# `live` is the safe deployment choice. `demo` enables deterministic generated
# data only for local exploration and automated tests.
MARKET_DATA_MODE=live

# --- Massive (formerly Polygon.io) ------------------------------------------
# Polygon rebranded to Massive in Oct 2025. api.polygon.io still resolves and
# existing keys work unchanged; api.massive.com is the documented host.
# Options chain snapshots with greeks/IV require Options Starter ($29/mo) or
# above -- the free tier is 5 req/min and cannot serve chain snapshots at all.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_REALTIME=false

# --- Webull OpenAPI ---------------------------------------------------------
# Generate the key/secret pair in the Webull app under Open API management.
# Market data entitlements are purchased SEPARATELY from API access.
# Options trading is available in the US and HK regions only.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
WEBULL_ACCOUNT_ID=
WEBULL_PAPER=true

# --- Earnings calendar ------------------------------------------------------
# Benzinga earnings via Massive is a separate PAID add-on (~$99/mo) on top of
# the Stocks plan, so it stays off unless you turn it on -- otherwise every
# request 403s and burns a retry.
BENZINGA_EARNINGS=false
# Finnhub free tier covers US earnings dates at 60 req/min.
FINNHUB_TOKEN=
# Nasdaq's calendar needs no key but is undocumented and unsupported: it can
# change shape or disappear without notice. Convenience, not infrastructure.
EARNINGS_ALLOW_NASDAQ=false
EARNINGS_CACHE_SECONDS=21600

# --- Volatility history -----------------------------------------------------
# IV rank is ranked against stored daily observations once there are enough of
# them; below this threshold the API falls back to a cross-sectional estimate
# and labels it as such rather than passing off a 6-day rank as a 52-week one.
IV_RANK_MIN_OBSERVATIONS=30
IV_RANK_WINDOW_DAYS=365

# --- Pricing model ----------------------------------------------------------
RISK_FREE_RATE=0.045
COMMISSION_PER_CONTRACT=0.65

# --- Cache TTLs (seconds) ---------------------------------------------------
# Keep these non-zero. Massive free is 5 req/min and Webull's option snapshot
# is 60 req/min, so an uncached UI would exhaust the budget in seconds.
QUOTE_CACHE_SECONDS=5
BARS_CACHE_SECONDS=60
CHAIN_CACHE_SECONDS=30
NEWS_CACHE_SECONDS=300

# --- Database ---------------------------------------------------------------
# Optional. Without it the API runs on an in-memory store: everything works,
# nothing survives a restart. SQLite works too and needs no server:
#   DATABASE_URL=sqlite+aiosqlite:///./marketshark.db
DATABASE_URL=postgresql+asyncpg://marketshark:marketshark@localhost:5432/marketshark

# --- AI ---------------------------------------------------------------------
# The rule-based tool layer always runs and needs no key. Supplying an Anthropic
# key adds the live Hermes-v0.19-inspired chat layer: durable local session
# memory, relevant-skill injection, and an LLM response grounded in the tools.
# It remains paper-only; no order-entry capability is exposed to the model.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000
